# Copiar a .env y ajustar valores. No commitear .env.
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=cryptoflow
COINGECKO_MOCK=true
LOG_LEVEL=INFO
SPARK_MASTER=local[*]
PROCESS_DATE=
# Consistencia de escritura a Cassandra.
# LOCAL_QUORUM = default (multi-node / producción)
# LOCAL_ONE    = single-node (Docker local)
CASSANDRA_OUTPUT_CONSISTENCY=LOCAL_QUORUM