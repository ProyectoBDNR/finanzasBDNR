# Copiar a .env y ajustar valores. No commitear .env.
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=cryptoflow

# Credenciales por rol. Usa valores fuertes en producción; estos son placeholders.
CASSANDRA_WRITER_USER=cf_writer
CASSANDRA_WRITER_PASSWORD=changeme_writer
CASSANDRA_ANALYST_USER=cf_analyst
CASSANDRA_ANALYST_PASSWORD=changeme_analyst
CASSANDRA_ADMIN_USER=cf_admin
CASSANDRA_ADMIN_PASSWORD=changeme_admin
# Password del superusuario `cassandra`. Valor por defecto de Cassandra;
# setup.py lo rota tras el bootstrap inicial.
CASSANDRA_SUPER_PASSWORD=cassandra

LOG_LEVEL=INFO
SPARK_MASTER=local[*]
# Hosts que usa el job de Spark para conectarse al cluster Cassandra.
CASSANDRA_SPARK_HOSTS=cassandra-1
SPARK_BATCH_INTERVAL_MINUTES=5
PROCESS_DATE=
# Consistencia de escritura a Cassandra.
# LOCAL_QUORUM = default (multi-node / producción)
# LOCAL_ONE    = single-node (Docker local)
CASSANDRA_OUTPUT_CONSISTENCY=LOCAL_QUORUM
